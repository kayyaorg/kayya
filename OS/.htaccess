Options -Indexes

# KAYYA Tor (seit 31.10.2026): geschuetzte Bereiche werden nur ueber gate.php ausgeliefert,
# das ein gueltiges Tor-Cookie verlangt (Zugangswort auf der Startseite). Direktaufruf -> Umleitung zur Startseite.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_URI} !^/gate\.php
  RewriteRule ^(g4/.*|g5/.*|g4\.html|g5\.html|beta1\.html|wartung\.html|docs/[^/]+\.html)$ gate.php?p=$1 [L,QSA,NC]
</IfModule>

# KAYYA OS - Schluesseldatei nie direkt ausliefern (Deploy laedt diese Datei mit hoch)
<Files "kayya-key.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

# ALLE .html nie cachen - Aenderungen sofort sichtbar (auch iPhone); Bilder/JS bleiben cachebar
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# KAYYA DB-Zugangsdaten nie ausliefern
<Files "kayya-db.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

# KAYYA: interne Unterlagen (Lastenheft, Planungen, Deck) nie ausliefern.
# Frei bleibt nur der One-Pager fuer Kostentraeger. Seiten (.html) sind nicht betroffen.
<FilesMatch "^(?!260823_V1_KAYYA_One-Pager_Kostentraeger\.docx$).+\.(docx|pptx|xlsx|pdf|zip)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
